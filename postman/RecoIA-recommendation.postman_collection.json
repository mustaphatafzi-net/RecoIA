{
  "info": {
    "name": "RecoIA - recommendation-service",
    "description": "Run collection dans l'ordre. Les tokens et ids se remplissent seuls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{studentToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "recAccept",
      "value": ""
    },
    {
      "key": "recAcceptCourse",
      "value": ""
    },
    {
      "key": "recReject",
      "value": ""
    },
    {
      "key": "recRejectCourse",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Preparation",
      "item": [
        {
          "name": "A - Inscription etudiant (Lina)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 ou 409\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Lina\",\n  \"lastName\": \"Test\",\n  \"email\": \"lina@recoia.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "B - Login etudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"studentToken\", j.token || j.accessToken);",
                  "pm.test(\"Token recu\", () => pm.expect(j.token || j.accessToken).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lina@recoia.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "C - Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\", j.token || j.accessToken);",
                  "pm.test(\"Token recu\", () => pm.expect(j.token || j.accessToken).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@recoia.com\",\n  \"password\": \"ChangeMe123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "D - Profil de Lina (interets 1 et 3, Master 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academicLevel\": \"MASTER_1\",\n  \"professionalGoal\": \"Travailler en IA\",\n  \"categoryIds\": [\n    1,\n    3\n  ],\n  \"skills\": [\n    {\n      \"skillId\": 1,\n      \"level\": \"INTERMEDIATE\"\n    },\n    {\n      \"skillId\": 4,\n      \"level\": \"BEGINNER\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1 - Recommandations",
      "item": [
        {
          "name": "1 - Ma liste de recommandations (5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"5 recommandations\", () => pm.expect(list.length).to.eql(5));",
                  "pm.test(\"Scores entre 0 et 100, en attente, avec une raison\", () => list.forEach(r => { pm.expect(r.score).to.be.within(0, 100); pm.expect(r.status).to.eql(\"PENDING\"); pm.expect(r.reason).to.be.a(\"string\"); pm.expect(r.courseTitle).to.be.a(\"string\"); }));",
                  "pm.test(\"Triees par score decroissant\", () => { for (let i = 1; i < list.length; i++) pm.expect(list[i-1].score).to.be.at.least(list[i].score); });",
                  "pm.collectionVariables.set(\"recAccept\", list[0].id);",
                  "pm.collectionVariables.set(\"recAcceptCourse\", list[0].courseId);",
                  "pm.collectionVariables.set(\"recReject\", list[1].id);",
                  "pm.collectionVariables.set(\"recRejectCourse\", list[1].courseId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/me?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "me"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "2 - Accepter la 1re",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ACCEPTED\", () => pm.expect(pm.response.json().status).to.eql(\"ACCEPTED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/{{recAccept}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "{{recAccept}}",
                "accept"
              ]
            }
          }
        },
        {
          "name": "3 - Refuser la 2e avec une raison",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"REJECTED\", () => pm.expect(j.status).to.eql(\"REJECTED\"));",
                  "pm.test(\"Raison enregistree\", () => pm.expect(j.feedbackReason).to.eql(\"Trop difficile\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/{{recReject}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "{{recReject}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trop difficile\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4 - Nouvelle liste : acceptee et refusee ont disparu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(r => r.courseId);",
                  "pm.test(\"Cours accepte absent\", () => pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"recAcceptCourse\"))));",
                  "pm.test(\"Cours refuse absent\", () => pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"recRejectCourse\"))));",
                  "pm.test(\"Toujours 5 propositions\", () => pm.expect(ids.length).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/me?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "me"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "5 - Historique : 1 acceptee + 1 refusee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Contient l acceptee\", () => pm.expect(h.some(r => r.id === Number(pm.collectionVariables.get(\"recAccept\")) && r.status === \"ACCEPTED\")).to.be.true);",
                  "pm.test(\"Contient la refusee\", () => pm.expect(h.some(r => r.id === Number(pm.collectionVariables.get(\"recReject\")) && r.status === \"REJECTED\")).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/me/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "me",
                "history"
              ]
            }
          }
        },
        {
          "name": "6 - Recommandation inexistante : 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/999999/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "999999",
                "accept"
              ]
            }
          }
        },
        {
          "name": "7 - Statistiques refusees a un etudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "stats"
              ]
            }
          }
        },
        {
          "name": "7b - Statistiques (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"Champs\", () => { [\"total\",\"pending\",\"accepted\",\"rejected\",\"acceptanceRate\",\"mostRecommended\"].forEach(k => pm.expect(s).to.have.property(k)); });",
                  "pm.test(\"Total coherent\", () => pm.expect(s.total).to.eql(s.pending + s.accepted + s.rejected));",
                  "pm.test(\"Top 3\", () => pm.expect(s.mostRecommended.length).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/stats?limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "stats"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "8 - Sans token : refuse par la gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}