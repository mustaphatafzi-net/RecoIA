        },
        {
          "name": "3b - Re-noter le cours 5 (2/5) : meme id, pas de doublon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Meme id\", () => pm.expect(j.id).to.eql(Number(pm.collectionVariables.get(\"ratingId\"))));",
                  "pm.test(\"Score mis a jour\", () => pm.expect(j.score).to.eql(2));"
                ]
              }
